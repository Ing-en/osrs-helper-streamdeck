{
  "name": "osrs-helper-streamdeck",
  "version": "1.0.0",
  "description": "Old School RuneScape keys for Stream Deck: idle alert and Time Tracking, read straight from RuneLite",
  "scripts": {
    "build": "node scripts/build-helper.mjs && node scripts/notices.mjs && rollup -c",
    "watch": "node scripts/build-helper.mjs && rollup -c -w --watch.onEnd=\"streamdeck restart com.ingen.osrs-helper\"",
    "pack": "npm run build && streamdeck pack com.ingen.osrs-helper.sdPlugin --output dist --force"
  },
  "author": "Ingen",
  "license": "BSD-2-Clause",
  "type": "module",
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^24.19.2",
    "rollup": "^4.67.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
